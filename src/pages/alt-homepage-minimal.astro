---
// MOCKUP - option 3 of 3 homepage alternatives (see alt-homepage-pillars,
// alt-homepage-magazine). Not linked from nav; reachable only by direct URL
// while comparing options. Delete once a direction is picked.
//
// Deliberately the smallest diff from the live index.astro: same five
// scroll-rails + feast-day footer, just with a thumbnail dropped into each
// card. LegendCard.astro itself isn't touched - this page inlines its own
// card markup (copied from LegendCard, plus a PillarGlyph) rather than
// adding an optional image prop to the shared component for a comparison
// page that may get deleted.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PillarGlyph from '../components/PillarGlyph.astro';
import FeastDayTile from '../components/FeastDayTile.astro';
import { excerptFrom } from '../lib/excerpt';
import { getUpcomingFeastDays } from '../lib/feastDays';
import { pillarFor, type PillarKey } from '../lib/pillarMeta';

const legendEntries = await getCollection('legends');
const traditionEntries = await getCollection('traditions');
const relicEntries = await getCollection('relics');
const symbolEntries = await getCollection('symbols');
const phenomenaEntries = await getCollection('phenomena');
const upcomingFeastDays = await getUpcomingFeastDays(3);

const borderClass: Record<string, string> = {
  accent: 'border-accent',
  ruby: 'border-ruby',
  'liturgical-green': 'border-liturgical-green',
  gold: 'border-gold',
  'liturgical-violet': 'border-liturgical-violet',
};
const bgClass: Record<string, string> = {
  accent: 'bg-accent',
  ruby: 'bg-ruby',
  'liturgical-green': 'bg-liturgical-green',
  gold: 'bg-gold',
  'liturgical-violet': 'bg-liturgical-violet',
};
const textClass: Record<string, string> = {
  accent: 'text-accent',
  ruby: 'text-ruby',
  'liturgical-green': 'text-liturgical-green',
  gold: 'text-gold',
  'liturgical-violet': 'text-liturgical-violet',
};
---

<Layout title="Hallowed Tales - Homepage Mockup: Minimal">
  <Hero
    eyebrow="Hallowed Tales"
    title="The Stories Behind the Faith"
    subtitle="Catholic legend, folk tradition, and the charming history behind the customs people still keep today."
    meta={['Legendary biography', 'Folk traditions', 'Symbols', 'Mystical phenomena']}
  />

  <main class="mx-auto max-w-5xl px-8 py-16">
    {[
      { title: 'Legends', seeAll: '/legends', pillarKey: 'legends' as PillarKey, entries: legendEntries, metaOf: (e: any) => e.data.earliestSource.approxDate },
      { title: 'Folk Traditions', seeAll: '/traditions', pillarKey: 'traditions' as PillarKey, entries: traditionEntries, metaOf: (e: any) => (e.data.feastDay ? `${e.data.feastDay.month} ${e.data.feastDay.day}` : e.data.category.replace('-', ' ')) },
      { title: 'Relics & Legendary Artifacts', seeAll: '/relics', pillarKey: 'relics' as PillarKey, entries: relicEntries, metaOf: (e: any) => e.data.claimedLocations.map((l: any) => l.site).join(' / ') },
      { title: 'Symbols', seeAll: '/symbols', pillarKey: 'symbols' as PillarKey, entries: symbolEntries, metaOf: (e: any) => e.data.meaning },
      { title: 'Mystical Phenomena', seeAll: '/phenomena', pillarKey: 'phenomena' as PillarKey, entries: phenomenaEntries, metaOf: (e: any) => e.data.phenomenonType.replace('-', ' ') },
    ].map((section, sectionIndex) => {
      const pillar = pillarFor(section.pillarKey);
      return (
        <section class:list={[sectionIndex > 0 && 'mt-16']}>
          <div class="mb-6 flex items-baseline justify-between">
            <h2 class="font-display text-3xl font-semibold text-ink">{section.title}</h2>
            <a href={section.seeAll} class="text-sm font-medium text-accent hover:underline">See all &rarr;</a>
          </div>
          <div class="flex gap-6 overflow-x-auto pt-2 pb-2 snap-x snap-mandatory [scrollbar-width:thin]">
            {section.entries.map((entry) => {
              const excerpt = excerptFrom(entry.body);
              const badgeTextClass = pillar.accentClass === 'gold' ? 'text-ink-fixed' : 'text-canvas';
              return (
                <div class="w-72 flex-shrink-0 snap-start">
                  <a
                    href={`${section.seeAll}/${entry.id}`}
                    class:list={['block overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1 border-t-4', borderClass[pillar.accentClass]]}
                  >
                    <PillarGlyph pillarKey={section.pillarKey} size="lg" />
                    <div class="p-6">
                      <span
                        class:list={['mb-4 inline-block rounded-full px-3 py-1 text-xs font-medium tracking-wide uppercase', badgeTextClass, bgClass[pillar.accentClass]]}
                      >
                        {pillar.badge}
                      </span>
                      <h3 class="mb-2 font-display text-2xl leading-snug font-semibold text-ink">{entry.data.title}</h3>
                      <p class="mb-4 text-sm leading-relaxed text-ink-soft">{excerpt}</p>
                      <p class:list={['text-xs', textClass[pillar.accentClass]]}>{section.metaOf(entry)}</p>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        </section>
      );
    })}

    <section class="mt-16">
      <h2 class="mb-6 font-display text-3xl font-semibold text-ink">Upcoming Feast Days</h2>
      <div class="flex flex-wrap gap-5">
        {upcomingFeastDays.map((feastDay, i) => (
          <FeastDayTile
            href={feastDay.href}
            month={feastDay.month}
            day={feastDay.day}
            title={feastDay.title}
            excerpt={feastDay.excerpt}
            fill={i % 2 === 0 ? 'gold' : 'accent'}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>
