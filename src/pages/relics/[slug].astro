---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import RelatedList from '../../components/RelatedList.astro';
import TagList from '../../components/TagList.astro';
import { resolveRelatedLegends } from '../../lib/related';
import { titleCaseSlug } from '../../lib/labels';

export const prerender = true;

// Every entry gets a real static page here, published or not - this is what
// makes a draft's own URL shareable. Discovery (listings, related links,
// feast lookups) is gated separately via `isPublished`; this file is not.
export async function getStaticPaths() {
  const entries = await getCollection('relics');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, cluster, claimedLocations, relatedLegends, tags } = entry.data;
const related = await resolveRelatedLegends(relatedLegends);

const clusterLabel = titleCaseSlug(cluster);
---

<Layout title={title} draft={!entry.data.published}>
  <Hero
    eyebrow="Relic & Legend"
    title={title}
    meta={[clusterLabel, claimedLocations.map((loc) => loc.site).join(' / ')]}
  />

  <main class="mx-auto max-w-3xl px-8 pt-10 pb-20">
    <div class="legend-body font-body text-ink">
      <Content />
    </div>
  </main>

  <TagList tags={tags} />
  <RelatedList links={related} />
</Layout>
