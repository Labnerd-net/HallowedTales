---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <main class="mx-auto max-w-3xl px-8 py-24 text-center">
    <p class="mb-2 font-display text-sm uppercase tracking-wide text-gold">404</p>
    <h1 class="mb-4 font-display text-4xl font-semibold text-ink">This story has wandered off</h1>
    <p class="mb-8 text-base leading-relaxed text-ink-soft">
      We couldn't find the page you were looking for. Try one of the doors below, or let us pick a story for you.
    </p>
    <p class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-accent">
      <a href="/" class="hover:underline">Home</a>
      <a href="/legends" class="hover:underline">Legends</a>
      <a href="/traditions" class="hover:underline">Folk Traditions</a>
      <a href="/random" class="hover:underline">Surprise me</a>
    </p>
  </main>
</Layout>
