---
import Layout from '../layouts/Layout.astro';
import { getFixedFeasts, getMovableFeastsInMonth } from '../lib/feasts';
import { getContentFeastDaysInMonth } from '../lib/feastDays';
import { getLiturgicalDay } from '../lib/liturgical/season';
import { barClass } from '../lib/liturgical/barClass';

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];
const DOW_NAMES = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const MIN_YEAR = 2020;
const MAX_YEAR = 2099;

// UTC calendar date, matching LiturgicalBanner - not the visitor's local date.
const now = new Date();
const todayYear = now.getUTCFullYear();
const todayMonth = now.getUTCMonth() + 1;
const todayDay = now.getUTCDate();

const rawMonth = Astro.url.searchParams.get('month');
const rawYear = Astro.url.searchParams.get('year');

let month = rawMonth ? parseInt(rawMonth, 10) : todayMonth;
let year = rawYear ? parseInt(rawYear, 10) : todayYear;
if (isNaN(month) || month < 1 || month > 12) month = todayMonth;
if (isNaN(year) || year < MIN_YEAR || year > MAX_YEAR) year = todayYear;

const prevMonth = month === 1 ? 12 : month - 1;
const prevYear = month === 1 ? year - 1 : year;
const nextMonth = month === 12 ? 1 : month + 1;
const nextYear = month === 12 ? year + 1 : year;

const monthName = MONTH_NAMES[month - 1];

const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
const firstDayOfWeek = new Date(Date.UTC(year, month - 1, 1)).getUTCDay();

const movableThisMonth = getMovableFeastsInMonth(year, month);
const contentThisMonth = await getContentFeastDaysInMonth(year, month);

interface DayCell {
  feasts: string[];
  content: { href: string; title: string }[];
}
const cells = new Map<number, DayCell>();
function getCell(day: number): DayCell {
  if (!cells.has(day)) cells.set(day, { feasts: [], content: [] });
  return cells.get(day)!;
}

for (let day = 1; day <= daysInMonth; day++) {
  for (const feast of getFixedFeasts(month, day)) {
    getCell(day).feasts.push(feast.name);
  }
}
for (const feast of movableThisMonth) {
  getCell(feast.day).feasts.push(feast.name);
}
for (const entry of contentThisMonth) {
  getCell(entry.day).content.push({ href: entry.href, title: entry.title });
}

function seasonFor(day: number) {
  return getLiturgicalDay(new Date(Date.UTC(year, month - 1, day)));
}

const grid: (number | null)[] = Array(firstDayOfWeek).fill(null);
for (let d = 1; d <= daysInMonth; d++) grid.push(d);
while (grid.length % 7 !== 0) grid.push(null);

// Past the supported range the page would silently clamp back to the current
// year, so the arrows stop instead of linking to a month that can't be shown.
const hasPrev = !(year === MIN_YEAR && month === 1);
const hasNext = !(year === MAX_YEAR && month === 12);

const isCurrentMonth = year === todayYear && month === todayMonth;
const agendaDays = Array.from({ length: daysInMonth }, (_, i) => i + 1).filter((d) => cells.has(d));
---

<Layout title={`${monthName} ${year} Feast Day Calendar`}>
  <main class="mx-auto max-w-5xl px-8 py-16">
    <div class="mb-8 flex items-center justify-between gap-4">
      {hasPrev ? (
        <a
          href={`/calendar?month=${prevMonth}&year=${prevYear}`}
          class="px-3 py-2 text-ink-soft hover:text-ink"
          aria-label="Previous month"
        >
          &larr;
        </a>
      ) : (
        <span class="px-3 py-2 text-ink-soft/40" aria-hidden="true">&larr;</span>
      )}
      <div class="text-center">
        <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">Feast Day Calendar</p>
        <h1 class="font-display text-3xl font-semibold text-ink">{monthName} {year}</h1>
        {!isCurrentMonth && (
          <a href="/calendar" class="text-xs text-accent hover:underline">Back to today</a>
        )}
      </div>
      {hasNext ? (
        <a
          href={`/calendar?month=${nextMonth}&year=${nextYear}`}
          class="px-3 py-2 text-ink-soft hover:text-ink"
          aria-label="Next month"
        >
          &rarr;
        </a>
      ) : (
        <span class="px-3 py-2 text-ink-soft/40" aria-hidden="true">&rarr;</span>
      )}
    </div>

    <!-- Mobile agenda -->
    <div class="flex flex-col divide-y divide-surface-alt md:hidden">
      {agendaDays.map((day) => {
        const cell = cells.get(day)!;
        const dow = DOW_NAMES[(firstDayOfWeek + day - 1) % 7];
        const isToday = isCurrentMonth && day === todayDay;
        const season = seasonFor(day);
        return (
          <div class:list={['flex gap-4 py-3', isToday && 'bg-surface-alt px-2']}>
            <div class:list={['w-1 shrink-0 self-stretch rounded-full', barClass[season.color]]} title={season.label}></div>
            <div class="flex w-10 shrink-0 flex-col items-center">
              <span class:list={['text-lg font-semibold', isToday ? 'text-accent' : 'text-ink']}>{day}</span>
              <span class="text-[10px] tracking-wide text-ink-soft uppercase">{dow}</span>
            </div>
            <div class="flex flex-col gap-1">
              {cell.content.map((c) => (
                <a href={c.href} class="text-sm font-medium text-accent hover:underline">{c.title}</a>
              ))}
              {cell.feasts.map((f) => (
                <span class="text-sm text-ink-soft">{f}</span>
              ))}
              <span class="sr-only">Season: {season.label}</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Desktop grid -->
    <div class="hidden grid-cols-7 border-t border-l border-surface-alt md:grid">
      {DOW_NAMES.map((d) => (
        <div class="border-r border-b border-surface-alt px-3 py-2 text-xs font-medium tracking-wide text-ink-soft uppercase">
          {d}
        </div>
      ))}
      {grid.map((day) => {
        if (day === null) return <div class="min-h-28 border-r border-b border-surface-alt bg-surface-alt/40" />;
        const cell = cells.get(day);
        const isToday = isCurrentMonth && day === todayDay;
        const season = seasonFor(day);
        return (
          <div class:list={['min-h-28 border-r border-b border-surface-alt', isToday && 'bg-surface-alt']} title={season.label}>
            <div class:list={['h-1 w-full', barClass[season.color]]}></div>
            <div class="p-2">
            <span class:list={['mb-1 block text-xs font-medium', isToday ? 'text-accent' : 'text-ink-soft']}>{day}</span>
            <div class="flex flex-col gap-0.5">
              {cell?.content.map((c) => (
                <a href={c.href} class="text-[11px] leading-tight font-medium text-accent hover:underline">{c.title}</a>
              ))}
              {cell?.feasts.map((f) => (
                <span class="text-[11px] leading-tight text-ink-soft">{f}</span>
              ))}
            </div>
            <span class="sr-only">Season: {season.label}</span>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t border-surface-alt pt-4 text-xs">
      <span class="font-medium text-accent">A HallowedTales entry</span>
      <span class="text-ink-soft">Liturgical feast (reference only)</span>
    </div>
    <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-xs text-ink-soft" aria-label="Season color key">
      <li class="flex items-center gap-2"><span class:list={['h-1 w-6', barClass.violet]}></span>Advent, Lent</li>
      <li class="flex items-center gap-2"><span class:list={['h-1 w-6', barClass.white]}></span>Christmas, Easter</li>
      <li class="flex items-center gap-2"><span class:list={['h-1 w-6', barClass.green]}></span>Ordinary Time</li>
      <li class="flex items-center gap-2"><span class:list={['h-1 w-6', barClass.rose]}></span>Gaudete / Laetare Sunday</li>
      <li class="flex items-center gap-2"><span class:list={['h-1 w-6', barClass.red]}></span>Palm Sunday, Good Friday, Pentecost</li>
    </ul>
    <p class="mt-2 text-xs text-ink-soft">Bands show the season color, not the vestment color of an individual saint's feast.</p>
  </main>
</Layout>
