---
import { getAllPublished, hrefFor } from '../lib/collections';

Astro.response.headers.set('Cache-Control', 'no-store');

// One flat pool so every published story is equally likely, rather than
// picking a pillar first (which over-weights the smaller pillars).
const pool = (await getAllPublished()).map((entry) => hrefFor(entry.collection, entry.id));

if (pool.length > 0) {
  return Astro.redirect(pool[Math.floor(Math.random() * pool.length)]);
}

return Astro.redirect('/');
---
