---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LegendCard from '../../components/LegendCard.astro';
import { excerptFrom } from '../../lib/excerpt';
import { isPublished } from '../../lib/published';

const entries = (await getCollection('symbols')).filter(isPublished);
---

<Layout title="Symbols">
  <main class="mx-auto max-w-5xl px-8 py-16">
    <h1 class="mb-8 font-display text-4xl font-semibold text-ink">Symbols</h1>
    <div class="grid gap-6 md:grid-cols-3">
      {entries.map((entry) => {
        const excerpt = excerptFrom(entry.body);
        return (
          <LegendCard
            href={`/symbols/${entry.id}`}
            badge="Symbol"
            title={entry.data.title}
            excerpt={excerpt}
            meta={entry.data.meaning}
            images={entry.data.images}
            featuredImageIndex={entry.data.featuredImageIndex}
          />
        );
      })}
    </div>
  </main>
</Layout>
