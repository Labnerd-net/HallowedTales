---
import Layout from '../layouts/Layout.astro';

const sample =
  "This story comes from The Golden Legend, a 13th-century collection of " +
  "saints' lives that became one of the most widely read books of the " +
  "Middle Ages. According to that telling, a dragon had taken up residence " +
  "near the city of Silene, poisoning the surrounding countryside with its breath.";

const candidates = [
  { name: 'Berkshire Swash (current)', family: 'Berkshire Swash', weight: 400 },
  { name: 'MedievalSharp', family: 'MedievalSharp', weight: 400 },
  { name: 'Metamorphous', family: 'Metamorphous', weight: 400 },
  { name: 'Pirata One', family: 'Pirata One', weight: 400 },
  {
    name: 'Almendra Display (synthetic bold - no real bold weight exists)',
    family: 'Almendra Display',
    weight: 400,
    stroke: true,
  },
];

const fontQuery = candidates
  .map((c) => `family=${c.family.replace(/ /g, '+')}${c.weight !== 400 ? `:wght@${c.weight}` : ''}`)
  .join('&');

const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
---

<Layout title="Drop cap preview (temp)">
  <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontQuery}&display=swap`} />
  <meta name="robots" content="noindex" />

  <main class="mx-auto max-w-2xl px-8 py-12">
    <h1 class="font-display text-3xl text-ink mb-2">Drop cap options</h1>
    <p class="text-ink-soft mb-10">
      Temp page for comparing drop-cap fonts on real body copy. Delete before merging.
    </p>

    {candidates.map((c) => (
      <section class="mb-14">
        <h2 class="font-display text-lg text-accent mb-3">{c.name}</h2>
        <div
          class:list={['dropcap-sample', 'legend-body', 'font-body', 'text-ink', { 'dropcap-sample--stroke': c.stroke }]}
          style={`--cap-font: '${c.family}'; --cap-weight: ${c.weight};`}
        >
          <p>{sample}</p>
        </div>
        <div
          class:list={['alphabet-row', 'text-ruby', { 'alphabet-row--stroke': c.stroke }]}
          style={`font-family: '${c.family}'; font-weight: ${c.weight};`}
        >
          {alphabet.map((letter) => <span>{letter}</span>)}
        </div>
      </section>
    ))}
  </main>
</Layout>

<style>
  .dropcap-sample > p:first-of-type::first-letter {
    font-family: var(--cap-font), var(--font-display);
    font-weight: var(--cap-weight);
    font-size: 5rem;
    line-height: 0.8;
    float: left;
    padding-right: 0.5rem;
    padding-top: 0.3rem;
    color: var(--color-ruby);
  }

  .alphabet-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    font-size: 2.25rem;
    line-height: 1;
    margin-top: 0.75rem;
  }

  .dropcap-sample--stroke > p:first-of-type::first-letter {
    -webkit-text-stroke: 1.25px var(--color-ruby);
  }

  .alphabet-row--stroke {
    -webkit-text-stroke: 1px var(--color-ruby);
  }
</style>
