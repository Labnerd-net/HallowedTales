---
// MOCKUP - option 1 of 3 homepage alternatives (see alt-homepage-magazine,
// alt-homepage-minimal). Not linked from nav; reachable only by direct URL
// while comparing options. Delete once a direction is picked.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LegendCard from '../components/LegendCard.astro';
import FeastDayTile from '../components/FeastDayTile.astro';
import PillarGlyph from '../components/PillarGlyph.astro';
import { excerptFrom } from '../lib/excerpt';
import { getUpcomingFeastDays } from '../lib/feastDays';
import { PILLARS } from '../lib/pillarMeta';

const countByPillar: Record<string, number> = {};
for (const pillar of PILLARS) {
  countByPillar[pillar.key] = (await getCollection(pillar.key as any)).length;
}

const upcomingFeastDays = await getUpcomingFeastDays(4);

// A handful of starting points under the pillar grid, one per collection,
// so there's still a direct path into a story without visiting an index
// page first.
const legendEntries = await getCollection('legends');
const traditionEntries = await getCollection('traditions');
const relicEntries = await getCollection('relics');
const symbolEntries = await getCollection('symbols');
const phenomenaEntries = await getCollection('phenomena');

const starters = [
  legendEntries[0] && { entry: legendEntries[0], collection: 'legends', badge: 'Legend' as const },
  traditionEntries[0] && { entry: traditionEntries[0], collection: 'traditions', badge: 'Folk Tradition' as const },
  relicEntries[0] && { entry: relicEntries[0], collection: 'relics', badge: 'Relic & Legend' as const },
  symbolEntries[0] && { entry: symbolEntries[0], collection: 'symbols', badge: 'Symbol' as const },
  phenomenaEntries[0] && { entry: phenomenaEntries[0], collection: 'phenomena', badge: 'Mystical Phenomenon' as const },
].filter((s): s is NonNullable<typeof s> => Boolean(s));

// Tailwind's scanner needs literal class strings, not `text-${var}` -
// same pattern LegendCard.astro uses for its badge accent lookup.
const countTextClass: Record<string, string> = {
  accent: 'text-accent',
  ruby: 'text-ruby',
  'liturgical-green': 'text-liturgical-green',
  gold: 'text-gold',
  'liturgical-violet': 'text-liturgical-violet',
};
---

<Layout title="Hallowed Tales - Homepage Mockup: Pillar Grid">
  <Hero
    eyebrow="Hallowed Tales"
    title="The Stories Behind the Faith"
    subtitle="Catholic legend, folk tradition, and the charming history behind the customs people still keep today."
    meta={['Legendary biography', 'Folk traditions', 'Symbols', 'Mystical phenomena']}
  />

  <main class="mx-auto max-w-5xl px-8 py-16">
    <section>
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="font-display text-3xl font-semibold text-ink">Today in the Calendar</h2>
        <a href="/calendar" class="text-sm font-medium text-accent hover:underline">Full calendar &rarr;</a>
      </div>
      <div class="flex flex-wrap gap-5">
        {upcomingFeastDays.map((feastDay, i) => (
          <FeastDayTile
            href={feastDay.href}
            month={feastDay.month}
            day={feastDay.day}
            title={feastDay.title}
            excerpt={feastDay.excerpt}
            fill={i % 2 === 0 ? 'gold' : 'accent'}
          />
        ))}
      </div>
    </section>

    <section class="mt-16">
      <div class="mb-6">
        <h2 class="font-display text-3xl font-semibold text-ink">Explore by Category</h2>
        <p class="mt-2 text-sm text-ink-soft">Five ways into the lore - start wherever pulls you in.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PILLARS.map((pillar) => (
          <a
            href={pillar.href}
            class="group block overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1"
          >
            <PillarGlyph pillarKey={pillar.key} size="lg" />
            <div class="p-6">
              <h3 class="mb-2 font-display text-2xl font-semibold text-ink">{pillar.label}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink-soft">{pillar.description}</p>
              <p class:list={['text-xs font-medium', countTextClass[pillar.accentClass]]}>
                {countByPillar[pillar.key]} {countByPillar[pillar.key] === 1 ? 'story' : 'stories'}
                <span class="ml-2 group-hover:underline">Explore &rarr;</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16">
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="font-display text-3xl font-semibold text-ink">A Few to Start With</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3 lg:grid-cols-5">
        {starters.map(({ entry, collection, badge }) => (
          <LegendCard
            href={`/${collection}/${entry.id}`}
            badge={badge}
            title={entry.data.title}
            excerpt={excerptFrom(entry.body)}
            meta={entry.data.earliestSource?.approxDate ?? ''}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>
