---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import RelatedList from '../../components/RelatedList.astro';
import TagList from '../../components/TagList.astro';
import { resolveRelatedLegends, findReferencingEntries, findBySaint } from '../../lib/related';
import { registerSaintHref } from '../../lib/registerLink';
import { formatSaints } from '../../lib/saints';

export const prerender = true;

// Every entry gets a real static page here, published or not - this is what
// makes a draft's own URL shareable. Discovery (listings, related links,
// feast lookups) is gated separately via `isPublished`; this file is not.
export async function getStaticPaths() {
  const entries = await getCollection('legends');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, saints, earliestSource, relatedLegends, tags } = entry.data;

const forwardLinks = await resolveRelatedLegends(relatedLegends);
const backwardLinks = await findReferencingEntries(entry.id);
const seen = new Set<string>();
const related = [...forwardLinks, ...backwardLinks].filter((link) =>
  seen.has(link.href) ? false : (seen.add(link.href), true)
);

const sameSaint = (await findBySaint(saints, 'legends', entry.id)).filter(
  (link) => seen.has(link.href) ? false : (seen.add(link.href), true)
);

const registerHref = registerSaintHref(saints);
---

<Layout title={title} draft={!entry.data.published}>
  <Hero
    eyebrow="Legend"
    title={title}
    meta={[formatSaints(saints)!, `Earliest source: ${earliestSource.approxDate}`]}
    note={
      registerHref
        ? "This saint also has a documented miracle case on The Miracle Register."
        : undefined
    }
    noteHref={registerHref}
    noteLabel={registerHref ? 'Visit The Miracle Register' : undefined}
  />

  <main class="mx-auto max-w-3xl px-8 pt-10 pb-20">
    <div class="legend-body font-body text-ink">
      <Content />
    </div>
  </main>

  <TagList tags={tags} />
  <RelatedList links={sameSaint} heading="More about this saint" />
  <RelatedList links={related} />
</Layout>
