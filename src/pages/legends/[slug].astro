---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import RelatedList from '../../components/RelatedList.astro';
import { resolveRelatedLegends, findReferencingEntries } from '../../lib/related';
import { registerSaintHref } from '../../lib/registerLink';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('legends');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, saints, earliestSource, images, relatedLegends } = entry.data;

const forwardLinks = await resolveRelatedLegends(relatedLegends);
const backwardLinks = await findReferencingEntries(entry.id);
const seen = new Set<string>();
const related = [...forwardLinks, ...backwardLinks].filter((link) =>
  seen.has(link.href) ? false : (seen.add(link.href), true)
);

const registerHref = registerSaintHref(saints);
---

<Layout title={title}>
  <Hero
    eyebrow="Legend"
    title={title}
    meta={[saints.join(', '), `Earliest source: ${earliestSource.approxDate}`]}
    note={
      registerHref
        ? 'This is a traditional story, not a verified historical record. Looking for the documented miracle case for this saint instead?'
        : 'This is a traditional story, not a verified historical record.'
    }
    noteHref={registerHref}
    noteLabel={registerHref ? 'Visit The Miracle Register' : undefined}
  />

  <div class="mx-auto max-w-3xl px-8">
    <ImageGallery images={images} />
  </div>

  <main class="mx-auto max-w-3xl px-8 pb-20">
    <div class="legend-body font-body text-ink">
      <Content />
    </div>
  </main>

  <RelatedList links={related} />
</Layout>
