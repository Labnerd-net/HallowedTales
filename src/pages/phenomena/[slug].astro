---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import RelatedList from '../../components/RelatedList.astro';
import { resolveRelatedLegends, findBySaint } from '../../lib/related';
import { registerMiracleHref } from '../../lib/registerLink';
import { formatSaints } from '../../lib/saints';
import { tagLabel } from '../../lib/tags';

export const prerender = true;

// Every entry gets a real static page here, published or not - this is what
// makes a draft's own URL shareable. Discovery (listings, related links,
// feast lookups) is gated separately via `isPublished`; this file is not.
export async function getStaticPaths() {
  const entries = await getCollection('phenomena');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, phenomenonType, saints, registerSlug, relatedLegends } = entry.data;
const related = await resolveRelatedLegends(relatedLegends);
const sameSaint = await findBySaint(saints, 'phenomena', entry.id);
const registerHref = registerMiracleHref(registerSlug);
---

<Layout title={title} draft={!entry.data.published}>
  <Hero
    eyebrow="Mystical Phenomenon"
    title={title}
    meta={[tagLabel(phenomenonType), formatSaints(saints)!]}
    note={
      registerSlug
        ? 'This same case is also documented on The Miracle Register, written in a voice explicit about the evidence it rests on.'
        : undefined
    }
    noteHref={registerHref}
    noteLabel={registerSlug ? 'View the Register entry' : undefined}
  />

  <main class="mx-auto max-w-3xl px-8 pt-10 pb-20">
    <div class="legend-body font-body text-ink">
      <Content />
    </div>
  </main>

  <RelatedList links={sameSaint} heading="More about this saint" />
  <RelatedList links={related} />
</Layout>
