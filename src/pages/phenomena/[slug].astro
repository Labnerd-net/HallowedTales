---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import RelatedList from '../../components/RelatedList.astro';
import { resolveRelatedLegends, findBySaint } from '../../lib/related';
import { registerMiracleHref } from '../../lib/registerLink';
import { formatSaints } from '../../lib/saints';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('phenomena');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, phenomenonType, saints, registerSlug, images, relatedLegends } = entry.data;
const related = await resolveRelatedLegends(relatedLegends);
const sameSaint = await findBySaint(saints, 'phenomena', entry.id);
const registerHref = registerMiracleHref(registerSlug);
---

<Layout title={title}>
  <Hero
    eyebrow="Mystical Phenomenon"
    title={title}
    meta={[phenomenonType.replace('-', ' '), formatSaints(saints)!]}
    note={
      registerSlug
        ? 'This same case is also documented on The Miracle Register, written in a voice explicit about the evidence it rests on.'
        : undefined
    }
    noteHref={registerHref}
    noteLabel={registerSlug ? 'View the Register entry' : undefined}
  />

  <div class="mx-auto max-w-3xl px-8 pt-10">
    <ImageGallery images={images} />
  </div>

  <main class="mx-auto max-w-3xl px-8 pb-20">
    <div class="legend-body font-body text-ink">
      <Content />
    </div>
  </main>

  <RelatedList links={sameSaint} heading="More about this saint" />
  <RelatedList links={related} />
</Layout>
