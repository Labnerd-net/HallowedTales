---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CardThumb from '../components/CardThumb.astro';
import FeastDayTile from '../components/FeastDayTile.astro';
import { excerptFrom } from '../lib/excerpt';
import { getUpcomingFeastDays } from '../lib/feastDays';
import { PILLARS, pillarFor, type PillarKey } from '../lib/pillarMeta';
import { getPublished } from '../lib/collections';

import georgeAndDragon from '../content/legends/george-and-the-dragon/uccello-george-dragon.jpg';
import palmSundayProcession from '../content/traditions/palm-sunday-palms/palm-sunday-procession.jpg';
import santoCaliz from '../content/relics/holy-grail/santo-caliz.jpg';
import catacombChiRho from '../content/symbols/chi-rho/catacomb-of-callixtus-chi-rho.jpg';
import padrePio1944 from '../content/phenomena/padre-pio-bilocation/padre-pio-1944.jpg';

// Picked from a set of candidates on a temp preview page - see commit
// history for the comparison. One representative image per category for
// the "Explore by Category" grid, distinct from CardThumb's per-entry
// `images` frontmatter.
const categoryHeroImages: Record<PillarKey, { src: ImageMetadata; alt: string }> = {
  legends: {
    src: georgeAndDragon,
    alt: 'Painting of Saint George on horseback spearing the dragon while the princess holds it on a leash made from her girdle',
  },
  traditions: {
    src: palmSundayProcession,
    alt: 'Photo of a priest in red vestments walking down an aisle of parishioners holding tall woven palm fronds during a Palm Sunday procession',
  },
  relics: {
    src: santoCaliz,
    alt: 'The Santo Caliz, an agate cup in a gold medieval mounting, displayed in Valencia Cathedral',
  },
  symbols: {
    src: catacombChiRho,
    alt: 'A Chi-Rho symbol scratched into a stone tablet in the Catacombs of San Callisto, Rome',
  },
  phenomena: {
    src: padrePio1944,
    alt: 'Black and white photo of Padre Pio celebrating Mass in Italy',
  },
};

// Tailwind's scanner needs literal class strings, not `text-${var}` -
// same pattern LegendCard.astro uses for its badge accent lookup.
const countTextClass: Record<string, string> = {
  accent: 'text-accent',
  ruby: 'text-ruby',
  'liturgical-green': 'text-liturgical-green',
  gold: 'text-gold',
  'liturgical-violet': 'text-liturgical-violet',
};
const borderClass: Record<string, string> = {
  accent: 'border-accent',
  ruby: 'border-ruby',
  'liturgical-green': 'border-liturgical-green',
  gold: 'border-gold',
  'liturgical-violet': 'border-liturgical-violet',
};

const [publishedLegends, publishedTraditions, publishedRelics, publishedSymbols, publishedPhenomena] =
  await Promise.all([
    getPublished('legends'),
    getPublished('traditions'),
    getPublished('relics'),
    getPublished('symbols'),
    getPublished('phenomena'),
  ]);

const countByPillar: Record<PillarKey, number> = {
  legends: publishedLegends.length,
  traditions: publishedTraditions.length,
  relics: publishedRelics.length,
  symbols: publishedSymbols.length,
  phenomena: publishedPhenomena.length,
};

const featured = publishedLegends.find((entry) => entry.data.featured) ?? publishedLegends[0];
const featuredExcerpt = featured ? excerptFrom(featured.body) : '';

// Same pick-one-at-random approach as /random.astro, re-rolled on every
// request since this page isn't prerendered (astro.config.mjs output: 'server').
function pickRandom<T>(items: T[]): T | undefined {
  return items.length ? items[Math.floor(Math.random() * items.length)] : undefined;
}

// Sidebar mixes a random entry from the other four pillars, plus one more
// random legend (excluding whichever is the featured pick).
const randomLegend = pickRandom(publishedLegends.filter((entry) => entry.id !== featured?.id));
const randomTradition = pickRandom(publishedTraditions);
const randomRelic = pickRandom(publishedRelics);
const randomSymbol = pickRandom(publishedSymbols);
const randomPhenomenon = pickRandom(publishedPhenomena);

const sidebarStories = [
  randomTradition && { entry: randomTradition, collection: 'traditions', pillarKey: 'traditions' as const, badge: 'Folk Tradition' },
  randomRelic && { entry: randomRelic, collection: 'relics', pillarKey: 'relics' as const, badge: 'Relic & Legend' },
  randomSymbol && { entry: randomSymbol, collection: 'symbols', pillarKey: 'symbols' as const, badge: 'Symbol' },
  randomPhenomenon && { entry: randomPhenomenon, collection: 'phenomena', pillarKey: 'phenomena' as const, badge: 'Mystical Phenomenon' },
  randomLegend && { entry: randomLegend, collection: 'legends', pillarKey: 'legends' as const, badge: 'Legend' },
]
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .map((s) => ({ ...s, accentClass: pillarFor(s.pillarKey).accentClass }));

const upcomingFeastDays = await getUpcomingFeastDays(3);
// Surface the nearest feast as a banner right under the hero once it's close
// enough to matter; otherwise it just sits in the "Next Feast Days"
// section at the bottom like the rest of the list.
const nearFeastDay = upcomingFeastDays.find((feastDay) => feastDay.daysUntil <= 14);
---

<Layout title="Hallowed Tales">
  <Hero
    eyebrow="Hallowed Tales"
    title="The Stories Behind the Faith"
    subtitle="Catholic legend, folk tradition, and the charming history behind the customs people still keep today."
    meta={['Legendary biography', 'Folk traditions', 'Symbols', 'Mystical phenomena']}
  />

  {nearFeastDay && (
    <div class="mx-auto max-w-5xl px-8 pt-8">
      <a
        href={nearFeastDay.href}
        class="flex items-center gap-4 rounded-lg border-l-4 border-gold bg-surface p-4 shadow-sm transition-transform hover:-translate-y-0.5"
      >
        <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-md bg-gold font-display text-ink-fixed">
          <span class="text-xs leading-none uppercase">{nearFeastDay.month}</span>
          <span class="text-xl leading-none font-semibold">{nearFeastDay.day}</span>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium tracking-wide text-gold uppercase">Coming up soon</p>
          <p class="truncate font-display text-lg font-semibold text-ink">{nearFeastDay.title}</p>
          <p class="truncate text-sm text-ink-soft">{nearFeastDay.excerpt}</p>
        </div>
        <span class="ml-auto shrink-0 text-sm font-medium text-accent">Read more &rarr;</span>
      </a>
    </div>
  )}

  <main class="mx-auto max-w-5xl px-8 py-16">
    <section class="grid gap-8 lg:grid-cols-3">
      {featured && (
        <a
          href={`/legends/${featured.id}`}
          class="group block overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1 lg:col-span-2 border-t-4 border-accent"
        >
          <CardThumb images={featured.data.images} featuredImageIndex={featured.data.featuredImageIndex} size="lg" />
          <div class="p-8">
            <span class="mb-4 inline-block rounded-full bg-accent px-3 py-1 text-xs font-medium tracking-wide text-canvas uppercase">
              Featured Legend
            </span>
            <h2 class="mb-3 font-display text-3xl leading-snug font-semibold text-ink">{featured.data.title}</h2>
            <p class="mb-4 text-base leading-relaxed text-ink-soft">{featuredExcerpt}</p>
            <p class="text-sm font-medium text-accent group-hover:underline">Read the story &rarr;</p>
          </div>
        </a>
      )}

      <div class="flex flex-col gap-4">
        <h2 class="font-display text-xl font-semibold text-ink">Read More</h2>
        {sidebarStories.map(({ entry, collection, badge, accentClass }) => (
          <a
            href={`/${collection}/${entry.id}`}
            class:list={['flex items-center gap-4 rounded-lg bg-surface p-3 shadow-sm transition-transform hover:-translate-y-0.5 border-t-4', borderClass[accentClass]]}
          >
            <CardThumb images={entry.data.images} featuredImageIndex={entry.data.featuredImageIndex} size="sm" />
            <div class="min-w-0">
              <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">{badge}</p>
              <p class="line-clamp-2 font-display text-base leading-tight font-semibold text-ink">{entry.data.title}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-surface-alt pt-10">
      <div class="mb-6">
        <h2 class="font-display text-3xl font-semibold text-ink">Explore by Category</h2>
        <p class="mt-2 text-sm text-ink-soft">Five ways into the lore - start wherever pulls you in.</p>
      </div>
      <div class="flex flex-wrap justify-center gap-6">
        {PILLARS.map((pillar) => (
          <a
            href={pillar.href}
            class:list={['group block w-full overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1 border-t-4 sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]', borderClass[pillar.accentClass]]}
          >
            <div class="h-36 w-full overflow-hidden rounded-md">
              <Image
                src={categoryHeroImages[pillar.key].src}
                alt={categoryHeroImages[pillar.key].alt}
                width={640}
                class="h-full w-full object-cover"
              />
            </div>
            <div class="p-6">
              <h3 class="mb-2 font-display text-2xl font-semibold text-ink">{pillar.label}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink-soft">{pillar.description}</p>
              <p class:list={['text-xs font-medium', countTextClass[pillar.accentClass]]}>
                {countByPillar[pillar.key]} {countByPillar[pillar.key] === 1 ? 'story' : 'stories'}
                <span class="ml-2 group-hover:underline">Explore &rarr;</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-surface-alt pt-10">
      <h2 class="mb-6 font-display text-xl font-semibold text-ink">Next Feast Days</h2>
      <div class="flex flex-wrap gap-5">
        {upcomingFeastDays.map((feastDay, i) => (
          <FeastDayTile
            href={feastDay.href}
            month={feastDay.month}
            day={feastDay.day}
            title={feastDay.title}
            excerpt={feastDay.excerpt}
            fill={i % 2 === 0 ? 'gold' : 'accent'}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>
