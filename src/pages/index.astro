---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import LegendCard from '../components/LegendCard.astro';
import FeastDayTile from '../components/FeastDayTile.astro';

const entries = await getCollection('legends');
---

<Layout title="Hallowed Tales">
  <Hero
    eyebrow="Hallowed Tales"
    title="The Stories Behind the Saints"
    subtitle="Catholic legend, folk tradition, and the charming history behind the customs people still keep today."
    meta={['Legendary biography', 'Folk traditions', 'Mystical phenomena']}
  />

  <main class="mx-auto max-w-5xl px-8 py-16">
    <section>
      <h2 class="mb-6 font-display text-3xl font-semibold text-ink">Legends</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {entries.map((entry) => {
          const excerpt = entry.body?.trim().split('\n\n')[0] ?? '';
          return (
            <LegendCard
              href={`/legends/${entry.id}`}
              badge="Legend"
              title={entry.data.title}
              excerpt={excerpt}
              meta={entry.data.earliestSource.approxDate}
            />
          );
        })}
      </div>
    </section>

    <section class="mt-16">
      <h2 class="mb-6 font-display text-3xl font-semibold text-ink">Upcoming Feast Days</h2>
      <div class="flex flex-wrap gap-5">
        <FeastDayTile month="Feb" day="3" saint="St. Blaise" custom="Blessing of the throats" fill="gold" />
        <FeastDayTile month="Dec" day="6" saint="St. Nicholas" custom="Shoes by the door, coins and sweets" fill="accent" />
        <FeastDayTile month="Mar" day="17" saint="St. Patrick" custom="Shamrocks and the driving-out of snakes" fill="gold" />
      </div>
    </section>
  </main>
</Layout>
