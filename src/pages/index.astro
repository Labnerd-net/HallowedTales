---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PillarGlyph from '../components/PillarGlyph.astro';
import FeastDayTile from '../components/FeastDayTile.astro';
import { excerptFrom } from '../lib/excerpt';
import { getUpcomingFeastDays } from '../lib/feastDays';
import { PILLARS, pillarFor } from '../lib/pillarMeta';

const countByPillar: Record<string, number> = {};
for (const pillar of PILLARS) {
  countByPillar[pillar.key] = (await getCollection(pillar.key as any)).length;
}

// Tailwind's scanner needs literal class strings, not `text-${var}` -
// same pattern LegendCard.astro uses for its badge accent lookup.
const countTextClass: Record<string, string> = {
  accent: 'text-accent',
  ruby: 'text-ruby',
  'liturgical-green': 'text-liturgical-green',
  gold: 'text-gold',
  'liturgical-violet': 'text-liturgical-violet',
};
const borderClass: Record<string, string> = {
  accent: 'border-accent',
  ruby: 'border-ruby',
  'liturgical-green': 'border-liturgical-green',
  gold: 'border-gold',
  'liturgical-violet': 'border-liturgical-violet',
};

const legendEntries = await getCollection('legends');
const traditionEntries = await getCollection('traditions');
const relicEntries = await getCollection('relics');
const symbolEntries = await getCollection('symbols');
const phenomenaEntries = await getCollection('phenomena');

const featured = legendEntries[0];
const featuredExcerpt = featured ? excerptFrom(featured.body) : '';

// Sidebar mixes the other four pillars' first entry each.
const sidebarStories = [
  traditionEntries[0] && { entry: traditionEntries[0], collection: 'traditions', pillarKey: 'traditions' as const, badge: 'Folk Tradition' },
  relicEntries[0] && { entry: relicEntries[0], collection: 'relics', pillarKey: 'relics' as const, badge: 'Relic & Legend' },
  symbolEntries[0] && { entry: symbolEntries[0], collection: 'symbols', pillarKey: 'symbols' as const, badge: 'Symbol' },
  phenomenaEntries[0] && { entry: phenomenaEntries[0], collection: 'phenomena', pillarKey: 'phenomena' as const, badge: 'Mystical Phenomenon' },
  legendEntries[1] && { entry: legendEntries[1], collection: 'legends', pillarKey: 'legends' as const, badge: 'Legend' },
]
  .filter((s): s is NonNullable<typeof s> => Boolean(s))
  .map((s) => ({ ...s, accentClass: pillarFor(s.pillarKey).accentClass }));

const upcomingFeastDays = await getUpcomingFeastDays(3);
---

<Layout title="Hallowed Tales">
  <Hero
    eyebrow="Hallowed Tales"
    title="The Stories Behind the Faith"
    subtitle="Catholic legend, folk tradition, and the charming history behind the customs people still keep today."
    meta={['Legendary biography', 'Folk traditions', 'Symbols', 'Mystical phenomena']}
  />

  <main class="mx-auto max-w-5xl px-8 py-16">
    <section class="grid gap-8 lg:grid-cols-3">
      {featured && (
        <a
          href={`/legends/${featured.id}`}
          class="group block overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1 lg:col-span-2 border-t-4 border-accent"
        >
          <PillarGlyph pillarKey="legends" size="lg" />
          <div class="p-8">
            <span class="mb-4 inline-block rounded-full bg-accent px-3 py-1 text-xs font-medium tracking-wide text-canvas uppercase">
              Featured Legend
            </span>
            <h2 class="mb-3 font-display text-3xl leading-snug font-semibold text-ink">{featured.data.title}</h2>
            <p class="mb-4 text-base leading-relaxed text-ink-soft">{featuredExcerpt}</p>
            <p class="text-sm font-medium text-accent group-hover:underline">Read the story &rarr;</p>
          </div>
        </a>
      )}

      <div class="flex flex-col gap-4">
        <h2 class="font-display text-xl font-semibold text-ink">Read More</h2>
        {sidebarStories.map(({ entry, collection, pillarKey, badge, accentClass }) => (
          <a
            href={`/${collection}/${entry.id}`}
            class:list={['flex items-center gap-4 rounded-lg bg-surface p-3 shadow-sm transition-transform hover:-translate-y-0.5 border-t-4', borderClass[accentClass]]}
          >
            <PillarGlyph pillarKey={pillarKey} size="sm" />
            <div class="min-w-0">
              <p class="text-xs font-medium tracking-wide text-ink-soft uppercase">{badge}</p>
              <p class="line-clamp-2 font-display text-base leading-tight font-semibold text-ink">{entry.data.title}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-surface-alt pt-10">
      <div class="mb-6">
        <h2 class="font-display text-3xl font-semibold text-ink">Explore by Category</h2>
        <p class="mt-2 text-sm text-ink-soft">Five ways into the lore - start wherever pulls you in.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {PILLARS.map((pillar) => (
          <a
            href={pillar.href}
            class:list={['group block overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1 border-t-4', borderClass[pillar.accentClass]]}
          >
            <PillarGlyph pillarKey={pillar.key} size="lg" />
            <div class="p-6">
              <h3 class="mb-2 font-display text-2xl font-semibold text-ink">{pillar.label}</h3>
              <p class="mb-4 text-sm leading-relaxed text-ink-soft">{pillar.description}</p>
              <p class:list={['text-xs font-medium', countTextClass[pillar.accentClass]]}>
                {countByPillar[pillar.key]} {countByPillar[pillar.key] === 1 ? 'story' : 'stories'}
                <span class="ml-2 group-hover:underline">Explore &rarr;</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-14 border-t border-surface-alt pt-10">
      <h2 class="mb-6 font-display text-xl font-semibold text-ink">Upcoming Feast Days</h2>
      <div class="flex flex-wrap gap-5">
        {upcomingFeastDays.map((feastDay, i) => (
          <FeastDayTile
            href={feastDay.href}
            month={feastDay.month}
            day={feastDay.day}
            title={feastDay.title}
            excerpt={feastDay.excerpt}
            fill={i % 2 === 0 ? 'gold' : 'accent'}
          />
        ))}
      </div>
    </section>
  </main>
</Layout>
