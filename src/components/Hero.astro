---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  meta: string[];
  note?: string;
  noteHref?: string;
  noteLabel?: string;
}

const { eyebrow, title, subtitle, meta, note, noteHref, noteLabel } = Astro.props;
---

<header
  class="relative m-3 overflow-hidden rounded-xl border border-gold/55 bg-accent-deep px-8 pt-20 pb-16 text-center text-cream dark:bg-[linear-gradient(180deg,var(--color-hero-deep),var(--color-canvas))] dark:text-ink"
>
  <div
    class="absolute inset-0 bg-[repeating-linear-gradient(45deg,var(--color-gold)_0_2px,transparent_2px_24px)] opacity-[0.07] dark:opacity-[0.07]"
  >
  </div>

  <div class="relative mx-auto max-w-3xl">
    <p class="mb-5 font-display text-base uppercase tracking-[0.25em] text-gold">
      &#10022; {eyebrow} &#10022;
    </p>

    <h1 class="font-display text-[3.25rem] leading-tight font-semibold">
      {title}
    </h1>

    {subtitle && (
      <p class="mx-auto mt-6 max-w-xl text-lg leading-[1.6] text-gold-soft dark:text-ink-soft">
        {subtitle}
      </p>
    )}

    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-xs text-cream/80 sm:gap-x-5 sm:text-sm dark:text-ink-soft">
      {meta.map((item, i) => (
        <>
          {i > 0 && <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>}
          <span class="whitespace-nowrap">{item}</span>
        </>
      ))}
    </div>
  </div>
</header>

{note && (
  <div class="mx-auto max-w-3xl px-8 py-8">
    <div class="flex items-start gap-3 rounded-r-lg border-l-4 border-gold bg-surface p-5">
      <span class="mt-0.5 font-display text-lg leading-none text-gold">&#10022;</span>
      <p class="text-sm leading-relaxed text-ink">
        {note}
        {noteHref && noteLabel && (
          <>
            {' '}
            <a href={noteHref} class="font-medium text-accent">{noteLabel} &rarr;</a>
          </>
        )}
      </p>
    </div>
  </div>
)}
