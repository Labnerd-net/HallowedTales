---
import { getLiturgicalDay, type LiturgicalColor } from '../lib/liturgical/season';
import { getFeastsForDate } from '../lib/feastDays';

const today = new Date();
const { label, color } = getLiturgicalDay(today);
const feasts = await getFeastsForDate(today);

// White/gold and red reuse the site's existing gold/ruby tokens rather than
// separate liturgical ones - see the comment in global.css.
const barClass: Record<LiturgicalColor, string> = {
  violet: 'bg-liturgical-violet',
  green: 'bg-liturgical-green',
  rose: 'bg-liturgical-rose',
  white: 'bg-gold',
  red: 'bg-ruby',
};

const colorLabel = color[0].toUpperCase() + color.slice(1);
---

<div>
  <div class:list={['h-1.5 w-full', barClass[color]]}></div>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-1 text-[11px] tracking-wide text-ink-soft uppercase">
    <p class="text-left">
      {feasts.length > 0 && (
        <>
          Today's Feasts:{' '}
          {feasts.map((feast, i) => (
            <>
              {i > 0 && ', '}
              {feast.href ? <a href={feast.href} class="text-accent hover:underline">{feast.label}</a> : feast.label}
            </>
          ))}
        </>
      )}
    </p>
    <p class="text-right">
      Today in the Church calendar: {label} &middot; {colorLabel}
    </p>
  </div>
</div>
