---
import { tagLabel } from '../lib/tags';

interface Props {
  tags: string[] | undefined;
}

const { tags } = Astro.props;
---

{tags && tags.length > 0 && (
  <ul class="mx-auto flex max-w-3xl flex-wrap gap-2 px-8 pb-12">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag}`}
          class="inline-block rounded-full bg-surface-alt px-3 py-1 text-xs font-medium text-ink-soft hover:bg-gold hover:text-ink-fixed"
        >
          {tagLabel(tag)}
        </a>
      </li>
    ))}
  </ul>
)}
