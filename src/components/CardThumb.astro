---
// Card art for an entry: every entry has at least one image (see
// content.config.ts imagesField), so this always has art to show.
// `featuredImageIndex` picks which image[] entry to use, defaulting to [0].
import { Image } from 'astro:assets';
import { featuredImage, type EntryImage } from '../lib/images';

interface Props {
  images: EntryImage[];
  featuredImageIndex?: number;
  size?: 'lg' | 'sm';
}

const { images, featuredImageIndex, size = 'lg' } = Astro.props;
const image = featuredImage(images, featuredImageIndex);

const dimensionClass = size === 'lg' ? 'h-36 w-full' : 'h-14 w-14 shrink-0';
---

<div class:list={['overflow-hidden rounded-md', dimensionClass]}>
  <Image src={image.src} alt={image.alt} width={size === 'lg' ? 640 : 112} class="h-full w-full object-cover" />
</div>
