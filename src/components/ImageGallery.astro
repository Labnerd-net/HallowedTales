---
import type { ImageMetadata } from 'astro';
import LightboxFigure from './LightboxFigure.astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  kind?: 'photo' | 'illustration' | 'artwork';
}

interface Props {
  images?: GalleryImage[];
}

const { images } = Astro.props;
---

{images && images.length > 0 && (
  <div
    class:list={[
      'my-6 grid gap-5',
      images.length === 1 ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2',
    ]}
  >
    {images.map((img) => (
      <LightboxFigure
        src={img.src}
        alt={img.alt}
        caption={img.caption}
        credit={img.credit}
        thumbClass="h-64"
      />
    ))}
  </div>
)}
