---
// Floats a single image beside the body text at the point in the story
// where it's relevant, instead of grouping all of an entry's images into
// one gallery before the prose. Used directly in MDX bodies.
import type { ImageMetadata } from 'astro';
import LightboxFigure from './LightboxFigure.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
  side?: 'left' | 'right';
}

const { src, alt, caption, credit, side = 'right' } = Astro.props;

const figureClass = [
  'not-prose my-2 w-full sm:w-[45%]',
  side === 'right' ? 'sm:float-right sm:ml-6' : 'sm:float-left sm:mr-6',
].join(' ');
---

<LightboxFigure src={src} alt={alt} caption={caption} credit={credit} figureClass={figureClass} />
