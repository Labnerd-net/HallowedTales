---
interface Props {
  month: string;
  day: string;
  saint: string;
  custom: string;
  fill?: 'gold' | 'accent';
}

const { month, day, saint, custom, fill = 'gold' } = Astro.props;
---

<div class="flex w-72 items-center gap-4 rounded-lg bg-surface p-4 shadow-md">
  <div
    class:list={[
      'flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-md font-display',
      fill === 'gold' ? 'bg-gold text-ink-fixed' : 'bg-accent text-canvas',
    ]}
  >
    <span class="text-xs leading-none uppercase">{month}</span>
    <span class="text-2xl leading-none font-semibold">{day}</span>
  </div>
  <div>
    <p class="font-display text-lg leading-tight font-semibold text-ink">{saint}</p>
    <p class="text-xs text-ink-soft">{custom}</p>
  </div>
</div>
