---
interface Props {
  href: string;
  month: string;
  day: string;
  title: string;
  excerpt: string;
  fill?: 'gold' | 'accent';
}

const { href, month, day, title, excerpt, fill = 'gold' } = Astro.props;
---

<a
  href={href}
  class="flex w-72 items-center gap-4 rounded-lg bg-surface p-4 shadow-md transition-transform hover:-translate-y-1"
>
  <div
    class:list={[
      'flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-md font-display',
      fill === 'gold' ? 'bg-gold text-ink-fixed' : 'bg-accent text-canvas',
    ]}
  >
    <span class="text-xs leading-none uppercase">{month}</span>
    <span class="text-2xl leading-none font-semibold">{day}</span>
  </div>
  <div>
    <p class="font-display text-lg leading-tight font-semibold text-ink">{title}</p>
    <p class="text-xs text-ink-soft">{excerpt}</p>
  </div>
</a>
