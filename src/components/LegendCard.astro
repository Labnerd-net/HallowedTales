---
import CardThumb from './CardThumb.astro';
import type { EntryImage } from '../lib/images';

export type Badge = 'Legend' | 'Folk Tradition' | 'Relic & Legend' | 'Mystical Phenomenon' | 'Symbol';

interface Props {
  href: string;
  badge: Badge;
  title: string;
  excerpt: string;
  meta: string;
  images: EntryImage[];
  featuredImageIndex?: number;
}

const { href, badge, title, excerpt, meta, images, featuredImageIndex } = Astro.props;

const accentByBadge: Record<Badge, 'accent' | 'ruby' | 'liturgical-green' | 'liturgical-violet' | 'gold'> = {
  Legend: 'accent',
  'Folk Tradition': 'ruby',
  'Relic & Legend': 'liturgical-green',
  'Mystical Phenomenon': 'liturgical-violet',
  Symbol: 'gold',
};
const accentClass = accentByBadge[badge];

const borderClass = {
  accent: 'border-accent',
  ruby: 'border-ruby',
  'liturgical-green': 'border-liturgical-green',
  'liturgical-violet': 'border-liturgical-violet',
  gold: 'border-gold',
}[accentClass];

const bgClass = {
  accent: 'bg-accent',
  ruby: 'bg-ruby',
  'liturgical-green': 'bg-liturgical-green',
  'liturgical-violet': 'bg-liturgical-violet',
  gold: 'bg-gold',
}[accentClass];

const textClass = {
  accent: 'text-accent',
  ruby: 'text-ruby',
  'liturgical-green': 'text-liturgical-green',
  'liturgical-violet': 'text-liturgical-violet',
  gold: 'text-gold',
}[accentClass];

// Gold's a bright/warm fill in both themes (see global.css), so it needs the
// fixed dark ink used elsewhere on gold fills rather than the light canvas
// text the other three badges use.
const badgeTextClass = accentClass === 'gold' ? 'text-ink-fixed' : 'text-canvas';
---

<a
  href={href}
  class:list={['block overflow-hidden rounded-lg bg-surface shadow-md transition-transform hover:-translate-y-1 border-t-4', borderClass]}
>
  <CardThumb images={images} featuredImageIndex={featuredImageIndex} size="lg" />
  <div class="p-6">
    <span
      class:list={[
        'mb-4 inline-block rounded-full px-3 py-1 text-xs font-medium tracking-wide uppercase',
        badgeTextClass,
        bgClass,
      ]}
    >
      {badge}
    </span>
    <h3 class="mb-2 font-display text-2xl leading-snug font-semibold text-ink">{title}</h3>
    <p class="mb-4 text-sm leading-relaxed text-ink-soft">{excerpt}</p>
    <p class:list={['text-xs', textClass]}>{meta}</p>
  </div>
</a>
