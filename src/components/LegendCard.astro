---
interface Props {
  href: string;
  badge: 'Legend' | 'Folk Tradition';
  title: string;
  excerpt: string;
  meta: string;
}

const { href, badge, title, excerpt, meta } = Astro.props;

const accentClass = badge === 'Legend' ? 'accent' : 'ruby';
---

<a
  href={href}
  class:list={[
    'block rounded-lg bg-surface p-6 shadow-md transition-transform hover:-translate-y-1 border-t-4',
    accentClass === 'accent' ? 'border-accent' : 'border-ruby',
  ]}
>
  <span
    class:list={[
      'mb-4 inline-block rounded-full px-3 py-1 text-xs font-medium tracking-wide uppercase text-canvas',
      accentClass === 'accent' ? 'bg-accent' : 'bg-ruby',
    ]}
  >
    {badge}
  </span>
  <h3 class="mb-2 font-display text-2xl leading-snug font-semibold text-ink">{title}</h3>
  <p class="mb-4 text-sm leading-relaxed text-ink-soft">{excerpt}</p>
  <p class:list={['text-xs', accentClass === 'accent' ? 'text-accent' : 'text-ruby']}>{meta}</p>
</a>
