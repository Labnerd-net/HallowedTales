---
// Decorative stand-in for a photo/illustration on homepage-mockup pages.
// No content entries have `images` populated yet, so these mockups need
// *something* in the image slot - a per-pillar line icon on a tinted,
// hatched plate (same diagonal-stripe texture as Hero.astro) rather than a
// placeholder.com fetch or a broken <img>. Swap for entry.data.images[0]
// once entries actually have art.
import { pillarFor, type PillarKey } from '../lib/pillarMeta';

interface Props {
  pillarKey: PillarKey;
  size?: 'lg' | 'sm';
}

const { pillarKey, size = 'lg' } = Astro.props;
const pillar = pillarFor(pillarKey);

const dimensionClass = size === 'lg' ? 'h-36 w-full' : 'h-14 w-14 shrink-0';
const iconSizeClass = size === 'lg' ? 'h-10 w-10' : 'h-6 w-6';

const textClass: Record<string, string> = {
  accent: 'text-accent',
  ruby: 'text-ruby',
  'liturgical-green': 'text-liturgical-green',
  gold: 'text-gold',
  'liturgical-violet': 'text-liturgical-violet',
};
---

<div
  class:list={['relative flex items-center justify-center overflow-hidden rounded-md', dimensionClass]}
  style={`background-color: color-mix(in srgb, var(${pillar.accentVar}) 10%, var(--color-surface)); background-image: repeating-linear-gradient(45deg, var(${pillar.accentVar}) 0 1.5px, transparent 1.5px 16px); background-blend-mode: normal; opacity: 1;`}
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={[iconSizeClass, textClass[pillar.accentClass]]}
  >
    {pillarKey === 'legends' && (
      <>
        <path d="M12 6.2c-2-1.1-4.4-1.4-7-.9v13c2.6-.5 5-.2 7 .9 2-1.1 4.4-1.4 7-.9v-13c-2.6-.5-5-.2-7 .9z" />
        <path d="M12 6.2v13" />
      </>
    )}
    {pillarKey === 'traditions' && (
      <>
        <path d="M12 3c1.1 1.9 1.9 3.4 1.9 4.6a1.9 1.9 0 1 1-3.8 0C10.1 6.4 10.9 4.9 12 3z" />
        <rect x="10.2" y="9.8" width="3.6" height="9.6" rx="0.6" />
      </>
    )}
    {pillarKey === 'relics' && (
      <>
        <circle cx="12" cy="12" r="8.4" />
        <path d="M12 7.4v9.2M7.6 12h8.8" />
      </>
    )}
    {pillarKey === 'symbols' && <path d="M12 2v20M2 12h20M5 5l14 14M19 5L5 19" />}
    {pillarKey === 'phenomena' && (
      <>
        <circle cx="12" cy="12" r="3.6" />
        <path d="M12 3v2.6M12 18.4V21M3 12h2.6M18.4 12H21M5.6 5.6l1.8 1.8M16.6 16.6l1.8 1.8M5.6 18.4l1.8-1.8M16.6 7.4l1.8-1.8" />
      </>
    )}
  </svg>
</div>
