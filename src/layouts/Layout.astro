---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/500.css';
import '@fontsource/lora/600.css';
import '@fontsource/lora/400-italic.css';
import '@fontsource/medievalsharp/400.css';
import LiturgicalBanner from '../components/LiturgicalBanner.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import BrandMark from '../components/BrandMark.astro';
import { DEFAULT_DESCRIPTION, SITE_NAME } from '../lib/seo';

interface Props {
  title: string;
  // Set when rendering an unpublished entry's own detail page - the page
  // still gets a real URL (so it's shareable for review) but shouldn't be
  // indexed or mistaken for a live page.
  draft?: boolean;
  // Meta/OG description; falls back to the site-wide one.
  description?: string;
  // Share-card image. Entry pages pass their featured image; everything else
  // gets the site icon.
  image?: ImageMetadata;
  // 'article' adds Article JSON-LD and og:type=article for story pages.
  type?: 'website' | 'article';
}

const { title, draft = false, description = DEFAULT_DESCRIPTION, image, type = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpeg' })).src, Astro.site)
  : new URL('/icon-512.png', Astro.site);
const fullTitle = `${title} - ${SITE_NAME}`;

const jsonLd =
  type === 'article'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description,
        image: shareImage.href,
        mainEntityOfPage: canonical.href,
        publisher: { '@type': 'Organization', name: SITE_NAME },
      }).replace(/</g, '\\u003c')
    : undefined;

// PUBLIC_UMAMI_ID overrides the website ID per environment; the fallback is
// the production ID so analytics don't silently stop if it isn't set.
const umamiId = import.meta.env.PUBLIC_UMAMI_ID ?? 'f351c3f0-12b5-4603-8fad-f0cd600664dc';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImage.href} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.href} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script defer src="https://umami.labnerd.net/script.js" data-website-id={umamiId}></script>
    <script is:inline>
      // Runs synchronously before paint so the page never flashes the wrong
      // theme - ThemeToggle's own script just has to sync button state
      // after this has already set the attribute.
      (function () {
        var stored = localStorage.getItem('theme');
        var choice = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : 'system';
        var resolved = choice === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : choice;
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.style.colorScheme = resolved;
      })();
    </script>
  </head>
  <body class="font-body">
    {draft && (
      <div class="bg-gold px-4 py-2 text-center text-sm font-medium text-ink-fixed">
        Draft - not yet published. This page isn't linked from anywhere else on the site.
      </div>
    )}
    <LiturgicalBanner />
    <nav class="relative z-50 flex items-center justify-between gap-4 bg-surface-alt px-4 py-3 text-sm font-medium text-ink-soft lg:grid lg:grid-cols-[1fr_auto_1fr]">
      <BrandMark />
      <div class="hidden items-center justify-center gap-6 lg:flex">
        <a href="/legends" class="hover:text-ink">Legends</a>
        <a href="/traditions" class="hover:text-ink">Folk Traditions</a>
        <a href="/relics" class="hover:text-ink">Relics</a>
        <a href="/symbols" class="hover:text-ink">Symbols</a>
        <a href="/phenomena" class="hover:text-ink">Mystical Phenomena</a>
        <a href="/tags" class="hover:text-ink">Tags</a>
        <a href="/random" class="hover:text-ink">Random</a>
      </div>
      <div class="flex items-center gap-3 lg:justify-end">
        <ThemeToggle />
        <button
          type="button"
          id="nav-menu-toggle"
          class="flex h-8 w-8 items-center justify-center rounded-md text-ink-soft hover:text-ink lg:hidden"
          aria-expanded="false"
          aria-controls="nav-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="nav-menu-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-5 w-5">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="nav-menu-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden h-5 w-5">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <div
        id="nav-menu"
        class="absolute inset-x-0 top-full hidden flex-col gap-1 border-t border-surface bg-surface-alt px-4 py-3 lg:hidden"
      >
        <a href="/legends" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Legends</a>
        <a href="/traditions" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Folk Traditions</a>
        <a href="/relics" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Relics</a>
        <a href="/symbols" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Symbols</a>
        <a href="/phenomena" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Mystical Phenomena</a>
        <a href="/tags" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Tags</a>
        <a href="/random" class="rounded-md px-2 py-2 hover:bg-surface hover:text-ink">Random</a>
      </div>
    </nav>
    <script>
      const toggle = document.getElementById('nav-menu-toggle');
      const menu = document.getElementById('nav-menu');
      const iconOpen = document.getElementById('nav-menu-icon-open');
      const iconClose = document.getElementById('nav-menu-icon-close');

      function setMenuOpen(open: boolean) {
        toggle?.setAttribute('aria-expanded', String(open));
        menu?.classList.toggle('hidden', !open);
        menu?.classList.toggle('flex', open);
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      }

      toggle?.addEventListener('click', () => {
        setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });

      document.addEventListener('click', (event) => {
        if (!menu || !toggle) return;
        if (menu.classList.contains('hidden')) return;
        if (menu.contains(event.target as Node) || toggle.contains(event.target as Node)) return;
        setMenuOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });
    </script>
    <slot />

    <footer class="mt-16 border-t border-surface bg-surface-alt px-4 py-8 text-center text-sm text-ink-soft">
      <p class="mx-auto max-w-2xl">
        HallowedTales gathers traditional stories, folk customs, and devotional lore as they've
        been told and handed down - it isn't a historical, medical, or archaeological
        verification record. For documented and sourced miracle cases, visit{' '}
        <a href="https://themiracleregister.org" class="font-medium text-accent">The Miracle Register</a>.
      </p>
    </footer>
  </body>
</html>
